kiosk-credential.json
!dist-template/kiosk-credential.json
!packaging/smoke/fixtures/kiosk-credential.json
*.pem
*.p12

# Local device config & data
kiosk.ini
!dist-template/kiosk.ini
!packaging/smoke/fixtures/kiosk.ini
*.log
spool/

