<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Kiosk Browser"
           Manufacturer="ptrkhh"
           Version="$(var.ProductVersion)"
           UpgradeCode="{74855634-8D61-4CFA-8FE1-A71BFCCC7A4D}"
           Scope="perMachine">
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of Kiosk Browser is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="KIOSK_ACCOUNT" Secure="yes" />
    <Property Id="INSTALLED_KIOSK_ACCOUNT">
      <RegistrySearch Id="KioskAccountSearch"
                      Root="HKLM"
                      Key="Software\ptrkhh\Kiosk Browser"
                      Name="KioskAccount"
                      Type="raw"
                      Bitness="always64" />
    </Property>
    <SetProperty Id="KIOSK_ACCOUNT"
                 Value="[INSTALLED_KIOSK_ACCOUNT]"
                 After="AppSearch"
                 Sequence="both"
                 Condition="NOT KIOSK_ACCOUNT AND INSTALLED_KIOSK_ACCOUNT" />
    <Launch Condition="Installed OR KIOSK_ACCOUNT" Message="KIOSK_ACCOUNT must name an existing enabled local non-administrator account." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="kiosk">
        <Component Id="MainExecutable" Guid="*">
          <File Id="MainExecutableFile" Source="$(var.RepoRoot)\target\release\kiosk-main.exe" KeyPath="yes" />
        </Component>
        <Component Id="LauncherExecutable" Guid="*">
          <File Id="LauncherExecutableFile" Source="$(var.RepoRoot)\target\release\kiosk-launcher.exe" KeyPath="yes" />
        </Component>
        <Component Id="ScheduledTaskDefinition" Guid="*">
          <File Id="ScheduledTaskXmlFile" Source="$(var.RepoRoot)\packaging\windows\KioskLauncher.xml" KeyPath="yes" />
        </Component>
        <Component Id="ScheduledTaskHelper" Guid="*">
          <File Id="ScheduledTaskHelperFile" Source="$(var.RepoRoot)\packaging\windows\install-task.ps1" KeyPath="yes" />
        </Component>
        <Component Id="KioskAccountRegistration" Guid="*">
          <RegistryValue Root="HKLM"
                         Key="Software\ptrkhh\Kiosk Browser"
                         Name="KioskAccount"
                         Type="string"
                         Value="[KIOSK_ACCOUNT]"
                         KeyPath="yes" />
        </Component>
        <Component Id="OfflineHtml" Guid="*">
          <File Id="OfflineHtmlFile" Source="$(var.RepoRoot)\crates\kiosk-main\bundled\offline.html" KeyPath="yes" />
        </Component>
        <Component Id="SplashHtml" Guid="*">
          <File Id="SplashHtmlFile" Source="$(var.RepoRoot)\crates\kiosk-main\bundled\splash.html" KeyPath="yes" />
        </Component>
        <Component Id="ErrorHtml" Guid="*">
          <File Id="ErrorHtmlFile" Source="$(var.RepoRoot)\crates\kiosk-main\bundled\error.html" KeyPath="yes" />
        </Component>
        <Component Id="PinpadHtml" Guid="*">
          <File Id="PinpadHtmlFile" Source="$(var.RepoRoot)\crates\kiosk-main\bundled\pinpad.html" KeyPath="yes" />
        </Component>
        <Component Id="SafeHtml" Guid="*">
          <File Id="SafeHtmlFile" Source="$(var.RepoRoot)\crates\kiosk-main\bundled\safe.html" KeyPath="yes" />
        </Component>
        <Component Id="OfflineVideo" Guid="*">
          <File Id="OfflineVideoFile" Source="$(var.RepoRoot)\dist-template\kiosk-offline.mp4" KeyPath="yes" />
        </Component>
        <Component Id="BootstrapConfig" Guid="*" Permanent="yes" NeverOverwrite="yes">
          <File Id="BootstrapConfigFile" Source="$(var.RepoRoot)\dist-template\kiosk.ini" KeyPath="yes" />
        </Component>
        <Component Id="Credential" Guid="*" Permanent="yes" NeverOverwrite="yes">
          <File Id="CredentialFile" Source="$(var.RepoRoot)\dist-template\kiosk-credential.json" KeyPath="yes">
            <PermissionEx Id="CredentialProtectedDacl" Sddl="D:P(A;;FA;;;SY)" />
            <util:PermissionEx User="[KIOSK_ACCOUNT]"
                               Read="yes"
                               ReadAttributes="yes"
                               ReadExtendedAttributes="yes"
                               ReadPermission="yes"
                               Synchronize="yes"
                               Inheritable="no" />
          </File>
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="KioskDataFolder" Name="kiosk">
        <Component Id="KioskDataDirectory" Guid="{25F0611A-8734-4EDB-918D-91C75065B4D4}" KeyPath="yes" Permanent="yes">
          <CreateFolder>
            <PermissionEx Id="DataProtectedDacl" Sddl="D:P(A;OICI;FA;;;SY)" />
            <util:PermissionEx User="[KIOSK_ACCOUNT]" GenericAll="yes" Inheritable="yes" />
          </CreateFolder>
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Complete" Title="Kiosk Browser" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="LauncherExecutable" />
      <ComponentRef Id="ScheduledTaskDefinition" />
      <ComponentRef Id="ScheduledTaskHelper" />
      <ComponentRef Id="KioskAccountRegistration" />
      <ComponentRef Id="OfflineHtml" />
      <ComponentRef Id="SplashHtml" />
      <ComponentRef Id="ErrorHtml" />
      <ComponentRef Id="PinpadHtml" />
      <ComponentRef Id="SafeHtml" />
      <ComponentRef Id="OfflineVideo" />
      <ComponentRef Id="BootstrapConfig" />
      <ComponentRef Id="Credential" />
      <ComponentRef Id="KioskDataDirectory" />
    </Feature>

    <SetProperty Id="RollbackKioskTaskInstall"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#ScheduledTaskHelperFile]&quot; -Action Rollback"
                 Before="RollbackKioskTaskInstall"
                 Sequence="execute"
                 Condition="NOT REMOVE~=&quot;ALL&quot;" />
    <SetProperty Id="PrepareKioskTaskInstall"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#ScheduledTaskHelperFile]&quot; -Action Prepare -ValidateAccount -Account &quot;[KIOSK_ACCOUNT]&quot;"
                 Before="PrepareKioskTaskInstall"
                 Sequence="execute"
                 Condition="NOT REMOVE~=&quot;ALL&quot;" />
    <SetProperty Id="RollbackKioskTaskUninstall"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#ScheduledTaskHelperFile]&quot; -Action Rollback"
                 Before="RollbackKioskTaskUninstall"
                 Sequence="execute"
                 Condition="REMOVE~=&quot;ALL&quot;" />
    <SetProperty Id="PrepareKioskTaskUninstall"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#ScheduledTaskHelperFile]&quot; -Action Prepare"
                 Before="PrepareKioskTaskUninstall"
                 Sequence="execute"
                 Condition="REMOVE~=&quot;ALL&quot;" />
    <SetProperty Id="RegisterKioskTask"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#ScheduledTaskHelperFile]&quot; -Action Install -Account &quot;[KIOSK_ACCOUNT]&quot; -LauncherPath &quot;[#LauncherExecutableFile]&quot; -TemplatePath &quot;[#ScheduledTaskXmlFile]&quot;"
                 Before="RegisterKioskTask"
                 Sequence="execute"
                 Condition="NOT REMOVE~=&quot;ALL&quot;" />
    <SetProperty Id="UnregisterKioskTask"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#ScheduledTaskHelperFile]&quot; -Action Uninstall"
                 Before="UnregisterKioskTask"
                 Sequence="execute"
                 Condition="REMOVE~=&quot;ALL&quot;" />
    <SetProperty Id="CommitKioskTask"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Remove-Item -LiteralPath (Join-Path $env:ProgramData 'kiosk\.installer-task') -Recurse -Force -ErrorAction SilentlyContinue&quot;"
                 Before="CommitKioskTask"
                 Sequence="execute" />

    <CustomAction Id="RollbackKioskTaskInstall" Directory="System64Folder" ExeCommand="[CustomActionData]" Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="PrepareKioskTaskInstall" Directory="System64Folder" ExeCommand="[CustomActionData]" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="RollbackKioskTaskUninstall" Directory="System64Folder" ExeCommand="[CustomActionData]" Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="PrepareKioskTaskUninstall" Directory="System64Folder" ExeCommand="[CustomActionData]" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="RegisterKioskTask" Directory="System64Folder" ExeCommand="[CustomActionData]" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="UnregisterKioskTask" Directory="System64Folder" ExeCommand="[CustomActionData]" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="CommitKioskTask" Directory="System64Folder" ExeCommand="[CustomActionData]" Execute="commit" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RollbackKioskTaskInstall" Before="PrepareKioskTaskInstall" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="PrepareKioskTaskInstall" Before="Wix4SchedSecureObjects_X64" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="RegisterKioskTask" After="PrepareKioskTaskInstall" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="RollbackKioskTaskUninstall" Before="PrepareKioskTaskUninstall" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="PrepareKioskTaskUninstall" Before="UnregisterKioskTask" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="UnregisterKioskTask" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="CommitKioskTask" After="UnregisterKioskTask" />
    </InstallExecuteSequence>
  </Package>
</Wix>
